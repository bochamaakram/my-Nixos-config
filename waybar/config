{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "height": 38,
    "margin-left": 10,
    "margin-right": 10,
    "margin-top": 7,
    "margin-bottom": 0,
    "spacing": 0,
    "reload_style_on_change": true,
    
    "modules-left": ["custom/nixos", "hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["network","bluetooth", "group/expand-3", "group/expand-2", "memory", "cpu", "battery", "clock"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": ""
        }
    },
    "custom/nixos": {
    "format": "󱄅",
    "on-click": "rofi -show drun -theme ~/.config/rofi/rofi-apps",
    "tooltip": false
    },
    
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": { "default": ["", "", ""] },
        "tooltip-format": "Volume: {volume}% {desc}"
    },

    "network": {
        "format-wifi": "󰤨 ",
        "format-ethernet": "󰈀 ",
        "format-disconnected": "󰤭 ",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "Ethernet: {ifname}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "kitty --class network-popup -e nmtui" 
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲", 
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱",
        "tooltip-format": "{controller_alias} - {status}",
        "tooltip-format-connected": "{device_alias} {device_battery_percentage}%",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "kitty -e bluetui"
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "cpu": { "format": "󰻠", "interval": 1 },
    "memory": { 
    "format": "󰑭", 
    "interval": 1,
    "tooltip-format": "RAM Usage: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)"
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 40,
        "separate-outputs": true
    },

    "group/expand-2": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 500, "transition-to-left": true, "click-to-reveal": true },
        "modules": ["backlight", "backlight/slider"]
    },

    "group/expand-3": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 500, "transition-to-left": true, "click-to-reveal": true },
        "modules": ["pulseaudio", "pulseaudio/slider"]
    },

    "backlight": { 
    "format": "{icon}", 
    "format-icons": ["󰃞", "󰃝", "󰃟", "󰃠"],
    "tooltip-format": "Brightness: {percent}%"
    },
    "backlight/slider": { "device": "intel_backlight" },
    "pulseaudio/slider": { "device": "pulseaudio" }
}