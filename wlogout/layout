{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "keybind" : "s",
    "width": 1,
    "height": 1
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "keybind" : "r",
    "width": 1,
    "height": 1
}
{
    "label" : "logout",
    "action" : "loginctl kill-session $XDG_SESSION_ID",
    "keybind" : "e",
    "width": 1,
    "height": 1
}
{
    "label" : "hibernate",
    "action" : "swaylock -f && systemctl hibernate",
    "keybind" : "h",
    "width": 1,
    "height": 1
}
{
    "label" : "lock",
    "action" : "hyprlock",
    "keybind" : "l",
    "width": 1,
    "height": 1
}
