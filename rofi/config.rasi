window {
    width:            450px;
    border:           2px;
    border-radius:    12px;
    padding:          20px;
}

mainbox {
    children: [ inputbar, listview ];
}

inputbar {
    children: [ prompt, entry ];
    border-radius: 8px;
    padding: 10px;
    margin: 0 0 10px 0;
}

listview {
    lines:      7;
    columns:    1;
    spacing:    5px;
    scrollbar:  false;
}

element {
    padding:    12px;
    border-radius: 8px;
}

element-icon {
    size: 24px;
    margin: 0 10px 0 0;
}