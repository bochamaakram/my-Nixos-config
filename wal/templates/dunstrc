[global]
    ### Display & Layout ###
    monitor = 0
    follow = mouse
    width = 300
    height = 200
    origin = top-right
    offset = 20x20
    scale = 0
    notification_limit = 5
    
    ### Progress Bar ###
    progress_bar = true
    progress_bar_height = 12
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    ### Appearance ###
    # Pywal Colors
    frame_color = "{color4}"
    separator_color = frame
    font = JetBrainsMono Nerd Font 10
    
    line_height = 0
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 2
    corner_radius = 12
    
    transparency = 5
    recursive_operations = false
    stack_duplicates = true
    hide_duplicate_count = false

    ### Icons ###
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

[urgency_low]
    # Pywal Colors
    background = "{background}"
    foreground = "{foreground}"
    timeout = 5

[urgency_normal]
    # Pywal Colors
    background = "{background}"
    foreground = "{foreground}"
    timeout = 10

[urgency_critical]
    # Pywal Colors
    background = "{background}"
    foreground = "{foreground}"
    frame_color = "{color1}"
    timeout = 0