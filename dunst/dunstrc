[global]
    ### Display ###
    monitor = 0
    origin = top-right
    offset = 20x20
    width = 300
    height = 200
    notification_limit = 5
    
    # Progress bar
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    ### Appearance ###
    transparency = 10
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 2
    
    # Pywal dynamic colors
    frame_color = "{color4}"
    separator_color = "frame"
    
    corner_radius = 10
    font = JetBrainsMono Nerd Font 10
    line_height = 0

    ### Text Formatting ###
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = true

    ### Icons ###
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_path = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/

[urgency_low]
    background = "{background}"
    foreground = "{foreground}"
    timeout = 5

[urgency_normal]
    background = "{background}"
    foreground = "{foreground}"
    timeout = 10

[urgency_critical]
    background = "{background}"
    foreground = "{foreground}"
    frame_color = "{color1}"
    timeout = 0