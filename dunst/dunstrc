[global]
    ### Display & Appearance ###
    width = (250, 400)
    height = 200
    offset = 20x20
    corner_radius = 12
    frame_width = 2
    
    # Catppuccin Mocha Palette
    # Background: #11111b (Crust) at 85% opacity for blur to work
    # Foreground: #cdd6f4 (Text)
    # Frame:      #cba6f7 (Mauve)
    
    background = "#11111b"
    foreground = "#cdd6f4"
    frame_color = "#cba6f7"
    
    # This value + Picom = Glassmorphism
    transparency = 15 
    
    font = JetBrainsMono Nerd Font 10
    padding = 12
    horizontal_padding = 15
    
    ### Progress Bar (Mauve themed) ###
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_foreground = "#cba6f7"
    progress_bar_background = "#313244" # Surface0

    ### Text Formatting ###
    # Title is Mauve, Body is Text
    format = "<span foreground='#cba6f7'><b>%s</b></span>\n%b"

[urgency_low]
    background = "#11111b"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa" # Blue
    timeout = 5

[urgency_normal]
    background = "#11111b"
    foreground = "#cdd6f4"
    frame_color = "#cba6f7" # Mauve
    timeout = 10

[urgency_critical]
    background = "#11111b"
    foreground = "#f38ba8" # Red
    frame_color = "#f38ba8"
    timeout = 0